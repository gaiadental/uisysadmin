# Custom Hooks Standards

## Rules

1. Always start hook names with `use`
2. Call hooks at top level only — never inside loops or conditions
3. Keep focused — one hook, one responsibility
4. Return stable references — use `useMemo` and `useCallback`
5. Provide explicit return type interfaces

## Custom Hook Template

```typescript
import { useState, useCallback } from 'react';

interface UseCounterOptions {
  initial?: number;
  min?: number;
  max?: number;
}

interface UseCounterReturn {
  count: number;
  increment: () => void;
  decrement: () => void;
  reset: () => void;
  set: (value: number) => void;
}

export function useCounter(options: UseCounterOptions = {}): UseCounterReturn {
  const { initial = 0, min = -Infinity, max = Infinity } = options;
  const [count, setCount] = useState(initial);

  const increment = useCallback(() => {
    setCount((c) => Math.min(c + 1, max));
  }, [max]);

  const decrement = useCallback(() => {
    setCount((c) => Math.max(c - 1, min));
  }, [min]);

  const reset = useCallback(() => {
    setCount(initial);
  }, [initial]);

  const set = useCallback((value: number) => {
    setCount(Math.max(min, Math.min(value, max)));
  }, [min, max]);

  return { count, increment, decrement, reset, set };
}
```

## useEffect Rules

```typescript
// Good: All dependencies listed
useEffect(() => {
  fetchData(id);
}, [id, fetchData]);

// Bad: Missing dependencies
useEffect(() => {
  fetchData(id);
}, []);
```

